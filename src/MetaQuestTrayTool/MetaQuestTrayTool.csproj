<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Icons\App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MetaQuestTrayTool</AssemblyName>
    <RootNamespace>MetaQuestTrayTool</RootNamespace>
    <Description>Windows tray utility for Meta Quest / Oculus Link and VR runtime settings.</Description>
    <ApplicationTitle>$(Product)</ApplicationTitle>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Publish defaults used by scripts/build-installer.ps1 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"></RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\App.ico" />
    <Resource Include="Resources\Icons\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\platform-tools\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="platform-tools\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyOverlayCompanion" AfterTargets="Build">
    <PropertyGroup>
      <_OverlayProject>$(MSBuildThisFileDirectory)..\MetaQuestTrayTool.Overlay\MetaQuestTrayTool.Overlay.csproj</_OverlayProject>
      <_OverlayRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)\</_OverlayRid>
      <_OverlayBin>$(MSBuildThisFileDirectory)..\MetaQuestTrayTool.Overlay\bin\$(Configuration)\net8.0-windows\$(_OverlayRid)</_OverlayBin>
    </PropertyGroup>
    <MSBuild Projects="$(_OverlayProject)" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup>
      <_OverlayFile Include="$(_OverlayBin)MetaQuestTrayTool.Overlay.exe" />
      <_OverlayFile Include="$(_OverlayBin)MetaQuestTrayTool.Overlay.dll" />
      <_OverlayFile Include="$(_OverlayBin)MetaQuestTrayTool.Overlay.deps.json" />
      <_OverlayFile Include="$(_OverlayBin)MetaQuestTrayTool.Overlay.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_OverlayFile)" DestinationFolder="$(OutputPath)overlay\" SkipUnchangedFiles="true" Condition="'@(_OverlayFile)' != ''" />
  </Target>

</Project>
