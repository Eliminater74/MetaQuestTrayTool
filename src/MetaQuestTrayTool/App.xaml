<Application x:Class="MetaQuestTrayTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151D2E"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#243049"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="AppMutedBrush" Color="#93A0B8"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#3DDCFF"/>
    <SolidColorBrush x:Key="AppAccentDarkBrush" Color="#1AA6A6"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppAccentDarkBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#148888"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1220"/>
      <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AppAccentBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0B1220"/>
      <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="Background" Value="#243049"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#31405F"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1C273C"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#243049"/>
                <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="PageHintStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Application.Resources>
</Application>
