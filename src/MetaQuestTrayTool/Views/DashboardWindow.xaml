<Window x:Class="MetaQuestTrayTool.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meta Quest Tray Tool"
        Height="560"
        Width="760"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Meta Quest Tray Tool"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource AppAccentBrush}"/>
      <TextBlock x:Name="VersionText"
                 Margin="0,4,0,16"
                 Foreground="{StaticResource AppMutedBrush}"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Start Service"
              Style="{StaticResource AccentButtonStyle}"
              Click="StartService_Click"/>
      <Button Content="Stop Service"
              Style="{StaticResource GhostButtonStyle}"
              Click="StopService_Click"/>
      <Button Content="Restart Service"
              Style="{StaticResource GhostButtonStyle}"
              Click="RestartService_Click"/>
      <Button Content="Refresh"
              Style="{StaticResource GhostButtonStyle}"
              Click="Refresh_Click"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{StaticResource AppSurfaceBrush}"
              BorderBrush="{StaticResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="OCULUS RUNTIME" FontSize="11" Foreground="{StaticResource AppMutedBrush}"/>
            <TextBlock x:Name="InstallPathText" Margin="0,8,12,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ServiceStatusText" Margin="0,8,12,0" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="SETTINGS" FontSize="11" Foreground="{StaticResource AppMutedBrush}"/>
            <TextBlock x:Name="SettingsPathText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0"
                       Text="Right-click the tray icon for the popup menu."
                       Foreground="{StaticResource AppMutedBrush}"/>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top"
                   Text="ACTIVITY LOG"
                   FontSize="11"
                   Margin="0,0,0,8"
                   Foreground="{StaticResource AppMutedBrush}"/>
        <Border Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
          <ListBox x:Name="LogList"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{StaticResource AppTextBrush}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
