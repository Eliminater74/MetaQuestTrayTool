<Window x:Class="MetaQuestTrayTool.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meta Quest Tray Tool"
        Height="660"
        Width="900"
        MinHeight="540"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Meta Quest Tray Tool"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock x:Name="VersionText"
                 Margin="0,4,0,16"
                 Foreground="{DynamicResource AppMutedBrush}"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Start Service"
              Style="{StaticResource AccentButtonStyle}"
              Click="StartService_Click"/>
      <Button Content="Stop Service"
              Style="{StaticResource GhostButtonStyle}"
              Click="StopService_Click"/>
      <Button Content="Restart Service"
              Style="{StaticResource GhostButtonStyle}"
              Click="RestartService_Click"/>
      <Button Content="Profiles"
              Style="{StaticResource GhostButtonStyle}"
              Click="Profiles_Click"/>
      <Button Content="Link Settings"
              Style="{StaticResource GhostButtonStyle}"
              Click="LinkSettings_Click"/>
      <Button Content="Audio"
              Style="{StaticResource GhostButtonStyle}"
              Click="AudioSettings_Click"/>
      <Button Content="Power"
              Style="{StaticResource GhostButtonStyle}"
              Click="PowerSettings_Click"/>
      <Button Content="Apply Game Settings"
              Style="{StaticResource AccentButtonStyle}"
              Click="ApplyGameSettings_Click"/>
      <Button Content="Refresh"
              Style="{StaticResource GhostButtonStyle}"
              Click="Refresh_Click"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="OCULUS RUNTIME" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
            <TextBlock x:Name="InstallPathText" Margin="0,8,12,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ServiceStatusText" Margin="0,8,12,0" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="GAME SETTINGS" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
            <TextBlock x:Name="GameSettingsText" Margin="0,8,12,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="DebugToolText" Margin="0,8,12,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="QUEST LINK" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
            <TextBlock x:Name="LinkSettingsText" Margin="0,8,12,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="LinkLiveText" Margin="0,8,12,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="SETTINGS FILE" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
            <TextBlock x:Name="SettingsPathText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="LastApplyText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedBrush}"/>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top"
                   Text="ACTIVITY LOG"
                   FontSize="11"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource AppMutedBrush}"/>
        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
          <ListBox x:Name="LogList"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{DynamicResource AppTextBrush}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
