<Window x:Class="MetaQuestTrayTool.Views.LinkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quest Link / Air Link"
        Height="640"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Apply" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
      <Button Content="Apply + Restart Service" Style="{StaticResource GhostButtonStyle}" Click="ApplyRestart_Click"/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Quest Link / Air Link"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"/>
        <TextBlock x:Name="LiveStatusText"
                   Margin="0,6,0,16"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Encode resolution width" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="EncodeWidthBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="1" Text="Encode bitrate (Mbps)" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="BitrateBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="2" Text="Encode dynamic bitrate" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="DynamicBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="3" Text="Dynamic bitrate max" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="DynamicMaxBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="4" Text="Dynamic bitrate offset" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="DynamicOffsetBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="5" Text="Sharpening" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="SharpenBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="6" Text="Distortion curvature" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="DistortionBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="7" Text="Prefer HEVC" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <CheckBox x:Name="HevcBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" Content="Prefer HEVC (H.265)"/>

          <TextBlock Grid.Row="8" Text="Sliced encoding" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <CheckBox x:Name="SlicesBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10" Content="Disable sliced encoding (numSlices = 1)"/>

          <TextBlock Grid.Row="9" Text="Mobile ASW" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox x:Name="MobileAswBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,10" Padding="6"/>

          <TextBlock Grid.Row="10" Text="Apply on start" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
          <CheckBox x:Name="ApplyOnStartBox" Grid.Row="10" Grid.Column="1" Content="Re-apply when the tray app starts"/>
        </Grid>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"
                   Text="Values are written to HKCU\Software\Oculus\RemoteHeadset. Reconnect Link or restart OVRService after applying."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
