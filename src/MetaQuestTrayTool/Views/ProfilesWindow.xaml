<Window x:Class="MetaQuestTrayTool.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profiles"
        Height="480"
        Width="640"
        MinHeight="400"
        MinWidth="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top"
               Text="Profiles"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{StaticResource AppAccentBrush}"/>
    <TextBlock DockPanel.Dock="Top"
               Margin="0,4,0,16"
               Foreground="{StaticResource AppMutedBrush}"
               Text="When auto-apply is on, these settings are pushed when that process starts and defaults are restored when it exits."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="New" Style="{StaticResource AccentButtonStyle}" Click="New_Click"/>
      <Button Content="Edit" Style="{StaticResource GhostButtonStyle}" Click="Edit_Click"/>
      <Button Content="Delete" Style="{StaticResource GhostButtonStyle}" Click="Delete_Click"/>
      <Button Content="Apply" Style="{StaticResource GhostButtonStyle}" Click="Apply_Click"/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"/>
    </StackPanel>

    <Border Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8">
      <ListBox x:Name="ProfileList"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{StaticResource AppTextBrush}"
               MouseDoubleClick="ProfileList_MouseDoubleClick"/>
    </Border>
  </DockPanel>
</Window>
