<Window x:Class="MetaQuestTrayTool.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MetaQuestTrayTool.Views.Converters"
        Title="Profiles"
        Height="560"
        Width="780"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <Window.Resources>
    <converters:PathToImageConverter x:Key="PathToImage"/>
  </Window.Resources>
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top"
               Text="Profiles"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{DynamicResource AppAccentBrush}"/>
    <TextBlock DockPanel.Dock="Top"
               Margin="0,4,0,16"
               TextWrapping="Wrap"
               Foreground="{DynamicResource AppMutedBrush}"
               Text="Personal profiles override global defaults while a game runs. When the game exits, global settings come back automatically and you get a tray notification. Profiles are stored in profiles.json. Built-in presets help you start quickly (MSFS, Beat Saber, etc.)."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Add from library"
              Style="{StaticResource AccentButtonStyle}"
              Click="AddFromLibrary_Click"
              ToolTip="Import a Steam or Meta library title as a new personal profile."/>
      <Button Content="New custom"
              Style="{StaticResource GhostButtonStyle}"
              Click="New_Click"
              ToolTip="Create a blank personal profile and set process name, SS, ASW, and Link overrides."/>
      <Button Content="Global defaults"
              Style="{StaticResource GhostButtonStyle}"
              Click="GlobalDefaults_Click"
              ToolTip="Edit the global SS / ASW / FOV defaults used when no profile is active."/>
      <Button Content="Edit"
              Style="{StaticResource GhostButtonStyle}"
              Click="Edit_Click"
              ToolTip="Edit the selected personal profile."/>
      <Button Content="Delete"
              Style="{StaticResource GhostButtonStyle}"
              Click="Delete_Click"
              ToolTip="Delete the selected profile from profiles.json."/>
      <Button Content="Apply"
              Style="{StaticResource GhostButtonStyle}"
              Click="Apply_Click"
              ToolTip="Apply the selected profile’s ODT / Link / ADB tweaks immediately."/>
      <Button Content="Close"
              Style="{StaticResource GhostButtonStyle}"
              Click="Close_Click"
              ToolTip="Close the profiles window."/>
    </StackPanel>

    <Border Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8">
      <ListBox x:Name="ProfileList"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{DynamicResource AppTextBrush}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="ProfileList_MouseDoubleClick"
               ToolTip="Personal profiles. Double-click to edit. Auto-apply swaps these in when the process starts.">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,5"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="88" Height="42" CornerRadius="6" ClipToBounds="True"
                      Background="{DynamicResource AppFieldBrush}" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock Text="{Binding PlatformGlyph}"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Foreground="{DynamicResource AppMutedBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                  <Image Source="{Binding Artwork, Converter={StaticResource PathToImage}}"
                         Stretch="UniformToFill"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource AppMutedBrush}" FontSize="12" Margin="0,2,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
