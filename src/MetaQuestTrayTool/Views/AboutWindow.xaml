<Window x:Class="MetaQuestTrayTool.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="440"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Donate" Style="{StaticResource AccentButtonStyle}" Click="Donate_Click"
              ToolTip="Open the donation page to support Meta Quest Tray Tool development."/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"
              ToolTip="Close the About window."/>
    </StackPanel>

    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock x:Name="AuthorText" Margin="0,6,0,0" FontWeight="SemiBold"/>
      <TextBlock x:Name="VersionText" Margin="0,4,0,16" Foreground="{DynamicResource AppMutedBrush}"/>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="A new Windows-only rewrite inspired by ApollyonVR's Oculus Tray Tool. Clean C# — not a decompiled port of the old VB.NET app."/>
      <TextBlock x:Name="DonateBlurbText"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource AppMutedBrush}"/>
    </StackPanel>
  </DockPanel>
</Window>
