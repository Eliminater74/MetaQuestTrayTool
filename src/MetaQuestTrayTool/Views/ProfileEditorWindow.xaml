<Window x:Class="MetaQuestTrayTool.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal profile"
        Width="520"
        MinHeight="620"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
      <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Personal profile"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"/>
        <TextBlock x:Name="ScopeText"
                   Margin="0,8,0,20"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"/>

        <TextBlock Text="Name" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,16"/>

        <TextBlock Text="Process name (without .exe)" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right"
                  Content="From library"
                  Margin="8,0,0,0"
                  Style="{StaticResource GhostButtonStyle}"
                  Click="BrowseLibrary_Click"/>
          <TextBox x:Name="ProcessBox"/>
        </DockPanel>

        <TextBlock Text="Platform" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="PlatformBox" Margin="0,0,0,16"/>

        <TextBlock Text="Super Sampling" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="SuperSamplingBox" Margin="0,0,0,16"/>

        <TextBlock Text="ASW mode" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="AswBox" Margin="0,0,0,16"/>

        <TextBlock Text="FOV multiplier" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="FovBox" Margin="0,0,0,4" Text="1.00"/>
        <TextBlock Text="1.00 leaves FOV unchanged. Range 0.50 – 1.50."
                   Foreground="{DynamicResource AppMutedBrush}"
                   FontSize="12"
                   Margin="0,0,0,16"/>

        <TextBlock Text="CPU priority" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="PriorityBox" Margin="0,0,0,16"/>

        <TextBlock Text="OpenXR runtime" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="OpenXrBox" Margin="0,0,0,4"/>
        <TextBlock Text="Inherit keeps the global Meta / SteamVR choice. A switch writes HKLM OpenXR ActiveRuntime and may prompt for Administrator."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"
                   FontSize="12"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Link overrides"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="Inherit keeps your global Quest Link page. Changing these writes HKCU\Software\Oculus\RemoteHeadset — reconnect Link if the stream does not update."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Link sharpening" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="SharpenBox" Margin="0,0,0,16"/>

        <TextBlock Text="Encode bitrate" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="BitrateBox" Margin="0,0,0,16"/>

        <TextBlock Text="Encode resolution" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="EncodeWidthBox" Margin="0,0,0,16"/>

        <TextBlock Text="Custom OculusDebugToolCLI commands"
                   Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <TextBlock Text="One command per line, after built-in SS / ASW / FOV. Example: set-pixels-per-display-pixel-override 1.3"
                   TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="CliCommandsBox" Margin="0,0,0,16" MinHeight="72" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

        <TextBlock Text="Custom headset ADB commands"
                   Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <TextBlock Text="One shell command per line, run only on your trusted Quest. You can omit the adb shell prefix."
                   TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="AdbCommandsBox" Margin="0,0,0,16" MinHeight="72" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

        <TextBlock Text="Notes" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="CommentsBox" Margin="0,0,0,8" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
