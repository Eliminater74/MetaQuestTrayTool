<Window x:Class="MetaQuestTrayTool.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile"
        Height="460"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
      <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Name" Foreground="{StaticResource AppMutedBrush}"/>
      <TextBox x:Name="NameBox" Margin="0,4,0,12" Padding="8,6"/>

      <TextBlock Text="Process name (without .exe)" Foreground="{StaticResource AppMutedBrush}"/>
      <TextBox x:Name="ProcessBox" Margin="0,4,0,12" Padding="8,6"/>

      <TextBlock Text="Super Sampling" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="SuperSamplingBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="ASW mode" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="AswBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="FOV multiplier (1.00 = unchanged)" Foreground="{StaticResource AppMutedBrush}"/>
      <TextBox x:Name="FovBox" Margin="0,4,0,12" Padding="8,6" Text="1.00"/>

      <TextBlock Text="CPU priority" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="PriorityBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="Notes" Foreground="{StaticResource AppMutedBrush}"/>
      <TextBox x:Name="CommentsBox" Margin="0,4,0,0" Padding="8,6"/>
    </StackPanel>
  </DockPanel>
</Window>
