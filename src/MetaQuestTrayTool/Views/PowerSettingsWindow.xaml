<Window x:Class="MetaQuestTrayTool.Views.PowerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Plan"
        Height="420"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Apply VR plan" Style="{StaticResource AccentButtonStyle}" Click="ApplyVr_Click"
              ToolTip="Switch Windows to the selected VR power plan right now."/>
      <Button Content="Restore fallback" Style="{StaticResource GhostButtonStyle}" Click="Restore_Click"
              ToolTip="Switch Windows back to the fallback (non-VR) power plan."/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"
              ToolTip="Close (changes already saved as you edit)."/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Power Plan"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock x:Name="ActivePlanText"
                 Margin="0,6,0,16"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource AppMutedBrush}"/>

      <CheckBox x:Name="AutoSwitchBox"
                Margin="0,0,0,8"
                Foreground="{DynamicResource AppTextBrush}"
                Content="Auto-switch with Oculus service"
                ToolTip="Switch to the VR plan when OVRService is running and restore fallback when it stops."/>

      <CheckBox x:Name="UsbBox"
                Margin="0,0,0,8"
                Foreground="{DynamicResource AppTextBrush}"
                Content="Disable USB selective suspend while VR plan is active"
                ToolTip="Keep USB ports awake under the VR plan so wired Link does not drop mid-session."/>

      <CheckBox x:Name="SleepBox"
                Margin="0,0,0,12"
                Foreground="{DynamicResource AppTextBrush}"
                Content="Restart OVRService after the PC wakes from sleep"
                ToolTip="After sleep/hibernate, restart OVRService so Link recovers more reliably."/>

      <TextBlock Text="VR power plan" Foreground="{DynamicResource AppMutedBrush}"/>
      <ComboBox x:Name="VrPlanBox" Margin="0,4,0,12" Padding="6"
                ToolTip="Windows power plan for VR sessions (High Performance / Ultimate recommended)."/>

      <TextBlock Text="Fallback power plan" Foreground="{DynamicResource AppMutedBrush}"/>
      <ComboBox x:Name="FallbackPlanBox" Margin="0,4,0,8" Padding="6"
                ToolTip="Plan restored when VR ends. Use Balanced or your everyday plan."/>

      <Button Content="Use current plan as fallback"
              HorizontalAlignment="Left"
              Style="{StaticResource GhostButtonStyle}"
              Click="CaptureFallback_Click"
              ToolTip="Remember the currently active Windows power plan as your fallback."/>
    </StackPanel>
  </DockPanel>
</Window>
