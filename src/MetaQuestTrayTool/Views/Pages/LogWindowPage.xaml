<UserControl x:Class="MetaQuestTrayTool.Views.Pages.LogWindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="20000"
             ToolTipService.BetweenShowDelay="200">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Left" Text="Log Window" Style="{StaticResource PageTitleStyle}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Clear log" Style="{StaticResource GhostButtonStyle}" Click="Clear_Click"
                ToolTip="Clear the in-memory log view. Does not delete files in the log folder."/>
        <Button Content="Refresh" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"
                ToolTip="Reload recent log lines from the tray logger into this list."/>
        <Button Content="Open log folder" Style="{StaticResource GhostButtonStyle}" Click="OpenFolder_Click"
                ToolTip="Open the on-disk log folder in Explorer for full history and diagnostics."/>
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageHintStyle}"
               Text="Startup checks, service actions, profile applies, Link writes, and audio/power events. Errors are red, warnings yellow."/>
    <Border Background="{DynamicResource AppFieldBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <ListBox x:Name="LogList"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource AppLogInfoBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                      <Setter Property="Foreground" Value="{DynamicResource AppLogErrorBrush}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                      <Setter Property="Foreground" Value="{DynamicResource AppLogWarnBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
