<UserControl x:Class="MetaQuestTrayTool.Views.Pages.HeadsetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="20000"
             ToolTipService.BetweenShowDelay="200">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Headset" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="SideQuest-style tweaks over ADB for VR headsets only (Quest 2/3/3S/Pro, Samsung Galaxy XR, HTC Vive standalone, Pico, Steam Frame). Phones, tablets, and emulators are ignored and never receive commands. Meta does not keep these after a reboot — leave apply-on-connect on so the tray pushes them again in VR."/>

      <TextBlock x:Name="StatusText" Margin="0,0,0,4" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="RuntimeText" Margin="0,0,0,12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"
                 ToolTip="Battery and Wi‑Fi from ADB dumpsys when the headset is connected for debugging."/>
      <CheckBox x:Name="ApplyOnConnectBox" Content="Apply these settings automatically when the headset connects"
                Checked="Persist_Changed" Unchecked="Persist_Changed"
                ToolTip="Push these ADB props when your trusted headset connects. Meta clears most props on reboot, so leave this on."/>

      <TextBlock Text="Wireless ADB" Style="{StaticResource SettingLabelStyle}" Margin="0,16,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="Same Wi‑Fi as the PC. Classic: USB → Enable tcpip → unplug → Connect. Or Quest Settings → Developer → Wireless debugging: Pair with code once, then Connect with the connect port. SideQuest running on the headset can also open an ADB port — use that headset LAN IP and port here (often 5555), then Connect."/>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Host (LAN IP)" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="WirelessHostBox" Grid.Row="0" Grid.Column="1" MaxWidth="280" HorizontalAlignment="Left"
                 Padding="6" Margin="0,0,0,8" LostFocus="Persist_Changed"
                 ToolTip="Headset Wi‑Fi IPv4, e.g. 192.168.1.40. Do not use Air Link alone — wireless ADB is separate. SideQuest on the headset can expose this path too."/>
        <TextBlock Grid.Row="1" Text="Connect port" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="WirelessPortBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                 Padding="6" Margin="0,0,0,8" LostFocus="Persist_Changed"
                 ToolTip="5555 after Enable tcpip or when SideQuest on the headset opens ADB. Wireless debugging uses the connect port on the main Wireless debugging screen (not the pairing port)."/>
        <TextBlock Grid.Row="2" Text="Pairing port" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="PairingPortBox" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                 Padding="6" Margin="0,0,0,8"
                 ToolTip="From Wireless debugging → Pair device with pairing code. Expires quickly; only needed for Pair. Not required if SideQuest (or tcpip) already opened ADB."/>
        <TextBlock Grid.Row="3" Text="Pairing code" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="PairingCodeBox" Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                 Padding="6" Margin="0,0,0,8" MaxLength="8"
                 ToolTip="6-digit code shown with the pairing port. Not saved — enter fresh each pair."/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Pair" Style="{StaticResource AccentButtonStyle}" Click="WirelessPair_Click"
                ToolTip="adb pair host:pairingPort code. Do this once (or after forgetting the device), then Connect with the connect port."/>
        <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="WirelessConnect_Click"
                ToolTip="adb connect host:connectPort. Works with tcpip, Wireless debugging, or a port opened by SideQuest on the headset. Remembered for next time."/>
        <Button Content="Disconnect" Style="{StaticResource GhostButtonStyle}" Click="WirelessDisconnect_Click"
                ToolTip="adb disconnect for this host:port (leaves USB devices alone when possible)."/>
        <Button Content="Enable tcpip (USB)" Style="{StaticResource GhostButtonStyle}" Click="WirelessTcpip_Click"
                ToolTip="Requires USB once: adb tcpip PORT, then unplug and Connect. Fills IP when the headset reports one. Skip if SideQuest on the headset already opened ADB."/>
      </StackPanel>
      <CheckBox x:Name="WirelessAutoBox" Content="Auto-reconnect wireless ADB when no headset is listed"
                Checked="Persist_Changed" Unchecked="Persist_Changed" Margin="0,0,0,8"
                ToolTip="Every ~45s while enabled, try the saved host:port if no ready VR headset is connected. Quiet while the Quest is off. Use after SideQuest/tcpip/Wireless debugging has opened a port once. Does not scan the LAN for other ADB devices."/>
      <CheckBox x:Name="HeadsetOnlyWirelessBox" Content="Headset-only wireless ADB"
                Checked="Persist_Changed" Unchecked="Persist_Changed" Margin="0,0,0,4"
                ToolTip="On by default. Drops wireless ADB sessions that are not a VR headset (phones/tablets ADB finds on the LAN, including mDNS). Uncheck to leave other wireless ADB devices connected. USB gadgets stay listed either way. Quest tweaks still never run on non-headsets."/>
      <TextBlock Style="{StaticResource PageHintStyle}" Margin="24,0,0,8"
                 Text="On by default so auto-connect cannot latch onto a phone. Uncheck if you want other wireless ADB devices (phones, tablets, Fire TV, etc.) to stay connected — commands still only apply to a VR headset."/>

      <TextBlock Text="Quality &amp; performance" Style="{StaticResource SettingLabelStyle}" Margin="0,8,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CPU / GPU level" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="CpuGpuBox" Grid.Row="0" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="ADB CPU/GPU performance level. Higher = more sustained performance and heat/battery use. Does not survive reboot."/>

        <TextBlock Grid.Row="1" Text="Texture size" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="TextureBox" Grid.Row="1" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Headset eye-buffer / texture size override via ADB. Higher looks sharper in standalone; costs GPU."/>

        <TextBlock Grid.Row="2" Text="Refresh rate" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="RefreshBox" Grid.Row="2" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Display refresh rate (Hz) via ADB. Higher is smoother; needs a headset that supports the mode."/>

        <TextBlock Grid.Row="3" Text="FFR" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="FfrBox" Grid.Row="3" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Fixed Foveated Rendering level. Higher FFR saves GPU at the cost of softer peripheral pixels."/>

        <TextBlock Grid.Row="4" Text="Chromatic aberration" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="ChromaBox" Grid.Row="4" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Chromatic aberration correction. On is usually correct; Off can look sharper but may show color fringing."/>
      </Grid>

      <TextBlock Text="Capture" Style="{StaticResource SettingLabelStyle}" Margin="0,12,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Video size" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="CaptureSizeBox" Grid.Row="0" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Headset capture / casting resolution. Higher looks better when recording; uses more encode bandwidth."/>

        <TextBlock Grid.Row="1" Text="Capture FPS" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="CaptureFpsBox" Grid.Row="1" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Capture frame rate. Pair with Full-rate capture if you want native refresh instead of half."/>

        <TextBlock Grid.Row="2" Text="Capture bitrate" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="CaptureBitrateBox" Grid.Row="2" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8" SelectionChanged="ComboPersist_Changed"
                  ToolTip="Capture encode bitrate. Higher reduces artifacts in recordings and casting."/>
      </Grid>
      <CheckBox x:Name="StereoBox" Content="Stereo capture (side-by-side)" Checked="Persist_Changed" Unchecked="Persist_Changed"
                ToolTip="Record / cast both eyes side-by-side. Useful for VR video; doubles horizontal resolution."/>
      <CheckBox x:Name="FullRateBox" Content="Full-rate capture (native refresh instead of half)" Checked="Persist_Changed" Unchecked="Persist_Changed"
                ToolTip="Capture at native headset refresh instead of half-rate. Smoother recordings; more encode load."/>

      <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
        <Button Content="Apply to headset now" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"
                ToolTip="Push all quality, capture, and custom ADB commands to the connected trusted headset now."/>
        <Button Content="Enable proximity" Style="{StaticResource GhostButtonStyle}" Click="ProxOn_Click"
                ToolTip="Re-enable the proximity sensor so the headset sleeps when you take it off."/>
        <Button Content="Disable proximity" Style="{StaticResource GhostButtonStyle}" Click="ProxOff_Click"
                ToolTip="Disable proximity so the display stays on when the headset is off your head (dev / capture)."/>
        <Button Content="Pause guardian" Style="{StaticResource GhostButtonStyle}" Click="GuardianPause_Click"
                ToolTip="Temporarily pause Guardian / boundary so you can move freely (use carefully)."/>
        <Button Content="Resume guardian" Style="{StaticResource GhostButtonStyle}" Click="GuardianResume_Click"
                ToolTip="Restore Guardian / boundary after pausing it."/>
      </StackPanel>

      <TextBlock Text="Paste text to headset" Style="{StaticResource SettingLabelStyle}" Margin="0,8,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="Focus a text field in the headset, then send. Useful for long passwords you do not want to type on the Quest keyboard."/>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Send" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" Click="SendText_Click"
                ToolTip="Send the text box contents into the focused field on the headset via ADB input."/>
        <TextBox x:Name="PasteBox"
                 ToolTip="Text to inject into the headset. Focus a text field in VR first, then Send."/>
      </DockPanel>

      <TextBlock Text="Trusted headset" Style="{StaticResource SettingLabelStyle}" Margin="0,16,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="The first real VR headset that connects is remembered. Emulators, phones, and tablets are never trusted. A different VR serial is blocked."/>
      <CheckBox x:Name="RequireTrustBox" Content="Only run ADB commands on the trusted headset"
                Checked="Persist_Changed" Unchecked="Persist_Changed" Margin="0,0,0,8"
                ToolTip="Block ADB tweaks unless the connected serial matches your trusted headset. Strongly recommended."/>
      <TextBlock x:Name="TrustText" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="Trust this headset" Style="{StaticResource GhostButtonStyle}" Click="Trust_Click"
                ToolTip="Remember the currently connected VR serial as the only headset allowed for ADB commands."/>
        <Button Content="Clear trust" Style="{StaticResource GhostButtonStyle}" Click="ClearTrust_Click"
                ToolTip="Forget the trusted serial so the next real VR headset can be trusted."/>
      </StackPanel>

      <TextBlock Text="Custom ADB commands (this headset)" Style="{StaticResource SettingLabelStyle}" Margin="0,8,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="One shell command per line. Applied with the tweaks above when the headset connects."/>
      <TextBox x:Name="CustomAdbBox" Margin="0,0,0,12" MinHeight="80" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
               LostFocus="Persist_Changed"
               ToolTip="Extra shell commands applied with headset tweaks on connect. One per line; props do not survive reboot."/>

      <TextBlock x:Name="ResultText" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"
                 Text="Skipped: MTP (use Explorer), BONELAB mods, and SideQuest experimental passthrough — those stay in SideQuest."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
