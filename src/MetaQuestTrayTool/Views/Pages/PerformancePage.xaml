<UserControl x:Class="MetaQuestTrayTool.Views.Pages.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Performance" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="Advisory diagnostics only. Nothing here changes Link, SteamVR, or headset settings. Headset ADB runs only when you press the headset sample button. PC history does not use ADB. Missing metrics stay blank. Hardware verification of clocks and experimental modes is pending."/>
      <TextBlock x:Name="SummaryText" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <TextBlock Text="Optional log" Style="{StaticResource SettingLabelStyle}"/>
      <TextBox x:Name="LogBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"
               ToolTip="Paste a VrApi line or a provider log. Analyze does not invent fields that are absent."/>
      <WrapPanel Margin="0,0,0,8">
        <Button Content="Analyze" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" Click="Analyze_Click"/>
        <Button Content="Sample headset (10s)" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="HeadsetSample_Click"
                ToolTip="Explicit ADB logcat sample. This is allowed while idle because you requested it. It does not start background polling."/>
        <Button Content="Sample PC GPU" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="PcSample_Click"
                ToolTip="Runs nvidia-smi if it is installed. Unsupported GPUs show unavailable."/>
        <Button Content="Start PC history" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="Start_Click"/>
        <Button Content="Pause" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="Pause_Click"/>
        <Button Content="Stop" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="Stop_Click"/>
        <Button Content="Score PC history" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="ScoreHistory_Click"
                ToolTip="Scores the PC GPU samples already collected. This is not a frame-time 1% low and it does not restart SteamVR."/>
        <Button Content="Save report" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="Save_Click"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="PC sample interval" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="IntervalBox" Width="120" SelectionChanged="Interval_Changed"/>
      </StackPanel>
      <TextBlock Text="Recent PC GPU utilization" Style="{StaticResource SettingLabelStyle}"/>
      <Border Height="120" Margin="0,0,0,8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppBackgroundBrush}">
        <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
      </Border>
      <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="220" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
