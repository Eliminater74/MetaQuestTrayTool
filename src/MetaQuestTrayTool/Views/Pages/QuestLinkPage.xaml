<UserControl x:Class="MetaQuestTrayTool.Views.Pages.QuestLinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="20000"
             ToolTipService.BetweenShowDelay="200">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Quest Link" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="These settings are for Quest when using Link / Air Link. Higher encode values need more GPU and PC encode headroom. Written to HKCU\Software\Oculus\RemoteHeadset."/>
      <TextBlock x:Name="SessionBanner" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"
                 Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold"/>

      <TextBlock Text="Air Link → SteamVR" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}" Margin="0,0,0,8"
                 Text="After Meta Link / Air Link connects, kill Oculus Dash and start SteamVR so Steam games run over Link. Options live on Service &amp; Startup."/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button Content="Kill Dash → SteamVR" Style="{StaticResource AccentButtonStyle}" Click="DashToSteamVr_Click"
                ToolTip="Kill OculusDash, optionally switch OpenXR to SteamVR, and launch SteamVR. Connect with Meta Link first. More options on Service &amp; Startup. Hotkey: Ctrl+Num 0."/>
      </StackPanel>

      <TextBlock Text="Global Link presets" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}" Margin="0,0,0,8"
                 Text="Pick a preset to fill the fields below, then Save (or Save &amp; Restart Service) to write the registry. Does not change game SS/ASW profiles."/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <ComboBox x:Name="PresetBox" MinWidth="220" MaxWidth="320" Padding="6"
                  SelectionChanged="PresetBox_SelectionChanged"
                  ToolTip="Fill encode / sharpen / HEVC fields from a preset. Does not write the registry until you Apply &amp; save or Save."/>
        <Button Content="Apply to fields" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                Click="ApplyPresetFields_Click"
                ToolTip="Copy the selected preset into the controls below without writing HKCU RemoteHeadset yet."/>
        <Button Content="Apply &amp; save" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                Click="ApplyPresetSave_Click"
                ToolTip="Apply the preset to the fields and write RemoteHeadset now. Reconnect Link or restart OVRService if the stream does not update."/>
      </StackPanel>
      <TextBlock x:Name="PresetHintText" Margin="0,0,0,16" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/>

      <StackPanel x:Name="MetaLinkPanel">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Encode Resolution" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="EncodeWidthBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="RemoteHeadset encode width (pixels). Higher looks sharper but needs more GPU encode headroom on Link / Air Link."/>

        <TextBlock Grid.Row="1" Text="Encode Bitrate" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="BitrateBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Target encode bitrate (Mbps) for Link / Air Link. Higher reduces compression artifacts; needs a strong USB or Wi‑Fi path."/>

        <TextBlock Grid.Row="2" Text="Encode Dynamic Bitrate" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="DynamicBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Dynamic Bitrate (DBR): let Meta raise/lower bitrate with network/GPU load instead of a fixed encode rate."/>

        <TextBlock Grid.Row="3" Text="Dynamic Bitrate Max" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="DynamicMaxBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Ceiling bitrate (Mbps) when Dynamic Bitrate is enabled. Cap this if Wi‑Fi or USB saturates."/>

        <TextBlock Grid.Row="4" Text="Dynamic Bitrate Offset" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="DynamicOffsetBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="DBR offset bias. Positive tends to push bitrate higher; negative is more conservative under load."/>

        <TextBlock Grid.Row="5" Text="Sharpening" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="SharpenBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Link post-encode sharpening. Helps soft compression look clearer; too high can add ringing/halo."/>

        <TextBlock Grid.Row="6" Text="Distortion Curvature" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="DistortionBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Lens distortion curvature used by the Link compositor. Leave default unless you know you need a custom curve."/>

        <TextBlock Grid.Row="7" Text="Prefer HEVC" Style="{StaticResource SettingLabelStyle}"/>
        <CheckBox x:Name="HevcBox" Grid.Row="7" Grid.Column="1" Content="Prefer HEVC (H.265)" Margin="0,0,0,10"
                  ToolTip="Prefer HEVC (H.265) encode for Link. Often better quality at the same bitrate; needs a capable NVENC/Quick Sync path."/>

        <TextBlock Grid.Row="8" Text="Sliced encoding" Style="{StaticResource SettingLabelStyle}"/>
        <CheckBox x:Name="SlicesBox" Grid.Row="8" Grid.Column="1" Content="Disable sliced encoding (NumSlices = 1)" Margin="0,0,0,10"
                  ToolTip="Force NumSlices = 1 (disable sliced encoding). Can improve quality or latency on some GPUs; leave off if you see encode stalls."/>

        <TextBlock Grid.Row="9" Text="Mobile ASW" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="MobileAswBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Mobile ASW on the headset side of Link. Helps smoothness when PC frame time dips; Off disables headset spacewarp."/>

        <TextBlock Grid.Row="10" Text="Apply on start" Style="{StaticResource SettingLabelStyle}"/>
        <CheckBox x:Name="ApplyOnStartBox" Grid.Row="10" Grid.Column="1" Content="Re-apply when the tray tool starts" Margin="0,0,0,10"
                  ToolTip="On tray start, rewrite these RemoteHeadset values so Link settings survive Meta client resets."/>
      </Grid>

      <TextBlock x:Name="LiveStatusText" Margin="0,4,0,12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal">
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"
                ToolTip="Write the current Link fields to HKCU\Software\Oculus\RemoteHeadset. Reconnect Link if the stream does not update."/>
        <Button x:Name="SaveRestartButton" Content="Save &amp; Restart Service" Style="{StaticResource GhostButtonStyle}" Click="SaveRestart_Click"
                ToolTip="Write RemoteHeadset, then restart OVRService so Link picks up encode changes more reliably."/>
      </StackPanel>
      </StackPanel>

      <Button Content="Read live registry" Style="{StaticResource GhostButtonStyle}" Margin="0,8,0,0"
              HorizontalAlignment="Left" Click="ReadLive_Click"
              ToolTip="Refresh the status line from the live HKCU RemoteHeadset values Meta is currently using."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
