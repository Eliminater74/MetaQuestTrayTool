<UserControl x:Class="MetaQuestTrayTool.Views.Pages.InfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="20000"
             ToolTipService.BetweenShowDelay="200">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Info" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="PCVR Ready checks your PC before you put the headset on. SteamVR-first tips are included because most Steam PCVR games expect SteamVR OpenXR."/>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="Donate" Style="{StaticResource AccentButtonStyle}" Click="Donate_Click"
                ToolTip="Open the donation page to support Meta Quest Tray Tool development."/>
        <Button Content="Refresh" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"
                ToolTip="Re-read Link, OpenXR, headset, ADB, and PCVR Ready status."/>
        <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Click="Copy_Click"
                ToolTip="Copy the full diagnostics report to the clipboard for support or bug reports."/>
        <Button Content="Trust this headset" Style="{StaticResource GhostButtonStyle}" Click="Trust_Click"
                ToolTip="Remember the connected VR serial as your trusted headset for ADB commands."/>
      </StackPanel>

      <TextBlock Text="PCVR Ready" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <TextBlock x:Name="ReadySummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Fix all" Style="{StaticResource AccentButtonStyle}" Click="FixAllReady_Click"
                ToolTip="Run fix actions for every checklist item that can be auto-fixed (OVRService, OpenXR, power, Link, GPU, Dash→SteamVR)."/>
        <Button Content="Re-check" Style="{StaticResource GhostButtonStyle}" Click="RefreshReady_Click"
                ToolTip="Re-evaluate the PCVR Ready checklist now."/>
      </StackPanel>
      <ItemsControl x:Name="ReadyItemsList" Margin="0,0,0,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource AppFieldBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LevelLabel}" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{Binding LevelBrush}"/>
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextBrush}"/>
                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                             Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding FixLabel}"
                        Style="{StaticResource GhostButtonStyle}" Margin="0"
                        Visibility="{Binding FixVisibility}"
                        Tag="{Binding Id}"
                        Click="FixReadyItem_Click"
                        VerticalAlignment="Center"
                        ToolTip="Apply the recommended fix for this checklist item."/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="ConnectionBanner" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock x:Name="SteamVrBanner" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <Button x:Name="InstallSteamVrButton" Content="Install SteamVR in Steam…" Style="{StaticResource AccentButtonStyle}"
              Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="Collapsed"
              Click="InstallSteamVr_Click"
              ToolTip="Opens Steam to install SteamVR (app 250820). Required for most Steam PCVR games."/>
      <TextBlock x:Name="GpuBanner" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock x:Name="OpenXrBanner" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock x:Name="HeadsetBanner" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <TextBlock x:Name="SteamTipBanner" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"
                 Foreground="OrangeRed"/>
      <Button x:Name="FixSteamOpenXrButton" Content="Switch OpenXR to SteamVR now" Style="{StaticResource AccentButtonStyle}"
              Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="Collapsed"
              Click="FixSteamOpenXr_Click"
              ToolTip="Steam Link / SteamVR session detected but OpenXR is not SteamVR. Switch ActiveRuntime to SteamVR for this session."/>
      <TextBlock x:Name="SteamVrHintBanner" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"
                 Foreground="{DynamicResource AppMutedBrush}"/>

      <Border x:Name="RecoverBanner" Background="{DynamicResource AppFieldBrush}"
              BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
              CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Recover PCVR" Style="{StaticResource AccentButtonStyle}"
                  Margin="8,0,0,0" Click="RecoverSession_Click"
                  ToolTip="Restart OVRService and re-apply Link, global game settings, and audio after a Link drop."/>
          <TextBlock x:Name="RecoverBannerText" TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{DynamicResource AppTextBrush}"/>
        </DockPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="Apply GPU recommended presets" Style="{StaticResource AccentButtonStyle}" Click="ApplyGpu_Click"
                ToolTip="Detect your GPU tier and apply matching Quest Link + global SS/ASW defaults. Does not change NVIDIA Control Panel / driver registry."/>
        <Button Content="Recover PCVR" Style="{StaticResource GhostButtonStyle}" Click="RecoverSession_Click"
                ToolTip="Restart OVRService and re-apply Link / globals / audio. Use after an unexpected Link drop."/>
      </StackPanel>

      <Border Background="{DynamicResource AppFieldBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12">
        <TextBox x:Name="ReportBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{DynamicResource AppTextBrush}"
                 FontFamily="Consolas"
                 FontSize="12"
                 MinHeight="280"
                 ToolTip="Live diagnostics: Link path, OpenXR ActiveRuntime, trusted serial, and ADB. Use Copy to share."/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
