<UserControl x:Class="MetaQuestTrayTool.Views.Pages.TrayToolPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Tray Tool" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="How the app behaves in Windows — startup, tray, audio switching, and notifications."/>

      <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
      <CheckBox x:Name="StartAsAdminBox" Content="Run with Administrator rights (recommended — set and forget)"
                Checked="Persist_Changed" Unchecked="Persist_Changed"/>
      <TextBlock Style="{StaticResource PageHintStyle}" Margin="28,0,0,12"
                 Text="On by default. One Windows approval the first time, then the tray starts itself at logon already elevated. OpenXR, Oculus service, and game profiles apply while you are in VR with no extra clicks. Uncheck only if you want a normal unelevated tray."/>
      <CheckBox x:Name="StartMinimizedBox" Content="Start minimized" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox x:Name="AudioSwitchBox" Content="Use Audio Switcher" VerticalAlignment="Center" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
        <Button Content="Configure" Style="{StaticResource GhostButtonStyle}" Margin="12,0,0,0" Click="AudioConfigure_Click"/>
      </StackPanel>
      <CheckBox x:Name="HideAltTabBox" Content="Hide from Alt+Tab" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
      <CheckBox x:Name="MinimizeOnCloseBox" Content="Close window to tray (stay running)" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox x:Name="HotKeysBox" Content="Enable HotKeys" VerticalAlignment="Center"
                  Checked="HotKeys_Changed" Unchecked="HotKeys_Changed"/>
        <Button Content="Configure" Style="{StaticResource GhostButtonStyle}" Margin="12,0,0,0" Click="HotKeysConfigure_Click"/>
      </StackPanel>
      <CheckBox x:Name="UpdatesBox" Content="Check for updates on start (placeholder)" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
      <CheckBox x:Name="NotificationsBox" Content="Show tray notifications" Checked="Persist_Changed" Unchecked="Persist_Changed"/>

      <TextBlock Text="Theme" Style="{StaticResource SettingLabelStyle}" Margin="0,12,0,8"/>
      <ComboBox x:Name="ThemeBox" MaxWidth="280" HorizontalAlignment="Left" Padding="6" SelectionChanged="Theme_Changed"/>

      <TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
