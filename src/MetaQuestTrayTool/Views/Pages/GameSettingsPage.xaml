<UserControl x:Class="MetaQuestTrayTool.Views.Pages.GameSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="20000"
             ToolTipService.BetweenShowDelay="200">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Game Settings" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="SS / ASW / FOV need Quest Link or Air Link (Meta on the PC). They do nothing if you started the Steam Link app — that streamer skips them on purpose. Want SteamVR games with those tweaks? Use Link + PreventDashLaunch (Service &amp; Startup), not the Steam Link app. Headset CPU/GPU is a separate ADB path and works on either pipe. Global defaults apply live; turn on Auto-apply profiles for per-game overrides."/>
      <TextBlock x:Name="SessionBanner" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"
                 Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold"/>

      <TextBlock Text="OpenXR runtime" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <ComboBox x:Name="OpenXrBox" MaxWidth="280" MinWidth="220" Padding="6"
                  ToolTip="Preferred OpenXR runtime written to HKLM ActiveRuntime (Meta Quest Link vs SteamVR). Needs Administrator to switch."/>
        <Button Content="Switch now" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" Click="SwitchOpenXr_Click"
                ToolTip="Write the selected OpenXR ActiveRuntime to HKLM now. May prompt for Administrator."/>
      </StackPanel>
      <CheckBox x:Name="OpenXrOnStartBox" Content="Apply preferred OpenXR runtime when the tool starts" Margin="0,0,0,6"
                ToolTip="On tray start, set HKLM OpenXR ActiveRuntime to your preferred Meta or SteamVR runtime."/>
      <CheckBox x:Name="SteamLinkOpenXrBox" Content="When Steam Link / SteamVR is active, switch OpenXR to SteamVR (restore preferred on exit)"
                Margin="0,0,0,16"
                ToolTip="While Steam Link / SteamVR is active, force OpenXR to SteamVR; restore your preferred runtime when that session ends."/>
      <TextBlock x:Name="OpenXrStatusText" Margin="0,0,0,16" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/>

      <TextBlock Text="Profiles" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="View &amp; Edit" Style="{StaticResource AccentButtonStyle}" Click="Profiles_Click"
                ToolTip="Open personal game profiles that override these globals while a matching process runs."/>
        <Button Content="Global defaults" Style="{StaticResource GhostButtonStyle}" Click="GlobalDefaults_Click"
                ToolTip="Open the focused editor for SS / ASW / FOV and custom CLI / ADB defaults."/>
      </StackPanel>

      <Grid x:Name="MetaOdtPanel">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Default Super Sampling" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="SuperSamplingBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Default OculusDebugToolCLI super sampling. Applied with globals; personal profiles can override. Gated under Steam Link / Virtual Desktop."/>

        <TextBlock Grid.Row="1" Text="Default ASW Mode" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="AswBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Default Asynchronous Spacewarp mode via OculusDebugToolCLI. Personal profiles can override while a game runs."/>

        <TextBlock Grid.Row="2" Text="Adaptive GPU Scaling" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="AdaptiveGpuBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="ODT adaptive GPU scaling. Lets the runtime lower resolution under load to protect frame time."/>

        <TextBlock Grid.Row="3" Text="FoV Multiplier (H / V)" Style="{StaticResource SettingLabelStyle}"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
          <TextBox x:Name="FovHBox" Width="80" Padding="6" Margin="0,0,8,0"
                   ToolTip="Horizontal FOV multiplier for OculusDebugToolCLI. 1.00 is unchanged; typical range 0.50–1.50. Saves when you leave the field."/>
          <TextBox x:Name="FovVBox" Width="80" Padding="6" Margin="0,0,8,0"
                   ToolTip="Vertical FOV multiplier for OculusDebugToolCLI. 1.00 is unchanged; typical range 0.50–1.50. Saves when you leave the field."/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="OVR Server Priority" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="PriorityBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="Windows process priority for OVRServer. Higher can reduce hitching; Extreme may starve other apps."/>

        <TextBlock Grid.Row="5" Text="Force MipMap On Layers" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="ForceMipBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="ODT force mipmaps on compositor layers. Can reduce shimmering on overlays."/>

        <TextBlock Grid.Row="6" Text="Offset MipMap On Layers" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="OffsetMipBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="ODT mipmap bias/offset on compositor layers. Fine-tunes sharpness vs aliasing."/>

        <TextBlock Grid.Row="7" Text="Use FOV Stencil" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="FovStencilBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="ODT FOV stencil. Masks unused pixels for a small GPU win; may clip edges if FOV is widened."/>

        <TextBlock Grid.Row="8" Text="Visual HUD" Style="{StaticResource SettingLabelStyle}"/>
        <ComboBox x:Name="HudBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10" Padding="6" MaxWidth="280" HorizontalAlignment="Left"
                  ToolTip="ODT performance HUD overlay (FPS, latency, etc.). Leave off for normal play."/>
      </Grid>

      <TextBlock Text="Close overlays on Link connect" Style="{StaticResource SettingLabelStyle}" Margin="0,16,0,6"/>
      <CheckBox x:Name="CloseOverlaysBox" Content="When Link / SteamVR / VD connects, close overlay / RGB / OSD processes below"
                Margin="0,0,0,6" Checked="OverlaySettings_Changed" Unchecked="OverlaySettings_Changed"
                ToolTip="Frees a bit of GPU/CPU by closing Afterburner OSD, RTSS, CAM, iCUE, etc. Never kills SteamVR, Oculus, or Discord."/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="One process name per line (no .exe). Safe defaults included — edit as needed. Off by default."/>
      <TextBox x:Name="OverlayListBox" Margin="0,0,0,12" MinHeight="64" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
               LostFocus="OverlayList_LostFocus"
               ToolTip="Processes to close when a PCVR session connects. SteamVR / Oculus / Discord are always protected."/>

      <TextBlock Text="Profile ignore list" Style="{StaticResource SettingLabelStyle}" Margin="0,16,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="One process name per line (no .exe). Auto-apply will never activate a profile for these — Discord, browsers, Steam helpers, etc."/>
      <TextBox x:Name="IgnoreListBox" Margin="0,0,0,12" MinHeight="72" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
               LostFocus="IgnoreList_LostFocus"
               ToolTip="Process names that must never steal the active personal profile. One per line."/>

      <TextBlock x:Name="CliCommandsLabel" Text="Custom OculusDebugToolCLI commands" Style="{StaticResource SettingLabelStyle}" Margin="0,16,0,6"/>
      <TextBlock x:Name="CliCommandsHint" Style="{StaticResource PageHintStyle}"
                 Text="One command per line. Applied with global defaults (Apply now, tool start, and after a personal profile ends)."/>
      <TextBox x:Name="CliCommandsBox" Margin="0,0,0,12" MinHeight="72" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
               LostFocus="CustomCommands_LostFocus"
               ToolTip="Extra OculusDebugToolCLI lines applied with globals. One command per line; runs after built-in SS / ASW / FOV."/>

      <TextBlock Text="Custom headset ADB commands" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <TextBlock Style="{StaticResource PageHintStyle}"
                 Text="One shell command per line. Runs only on your trusted Quest when global defaults are applied."/>
      <TextBox x:Name="AdbCommandsBox" Margin="0,0,0,12" MinHeight="72" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
               LostFocus="CustomCommands_LostFocus"
               ToolTip="Shell commands for your trusted headset when globals apply. One per line; ADB props do not survive reboot."/>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="ApplyNowButton" Content="Re-apply now" Style="{StaticResource GhostButtonStyle}" Click="Apply_Click"
                ToolTip="Push current global defaults again (ODT + custom CLI/ADB). Usually not needed — changes already apply live."/>
        <Button x:Name="SaveLastGoodButton" Content="Save to active profile" Style="{StaticResource AccentButtonStyle}" Click="SaveLastGood_Click"
                ToolTip="While a game profile is active, save the current SS/ASW/FOV (and Link overrides) back into that profile as last-good."/>
        <Button Content="Open Debug Tool" Style="{StaticResource GhostButtonStyle}" Click="OpenDebugTool_Click"
                ToolTip="Launch Meta’s Oculus Debug Tool GUI (OculusDebugTool.exe). Same shortcut as classic OTT. Connect Link first; close/reopen if values look stale."/>
        <CheckBox x:Name="ApplyOnStartBox" Content="Apply on tool start" VerticalAlignment="Center" Margin="8,0,0,0"
                  ToolTip="When the tray starts, apply global defaults if no personal profile is active."/>
        <CheckBox x:Name="AutoApplyBox" Content="Auto-apply profiles" VerticalAlignment="Center" Margin="16,0,0,0"
                  ToolTip="When a matching game process starts, apply its personal profile; restore globals when it exits."/>
      </StackPanel>

      <TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
