<Window x:Class="MetaQuestTrayTool.Views.VoiceCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Commands"
        Height="620"
        Width="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Test listen once" Style="{StaticResource GhostButtonStyle}" Click="TestListen_Click"
              ToolTip="Listen once with Windows speech recognition and show which phrase matched (if any)."/>
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"
              ToolTip="Save voice settings and push-to-talk shortcut. No restart required."/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"
              ToolTip="Close without saving unsaved edits."/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Voice Commands"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"/>
        <TextBlock Style="{StaticResource PageHintStyle}"
                   Text="Core OTT-style phrases using Windows speech recognition. Push-to-talk is recommended in VR so game audio does not trigger commands."/>
        <TextBlock x:Name="StatusText"
                   Margin="0,6,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"/>

        <CheckBox x:Name="EnabledBox" Content="Enable voice commands" Margin="0,0,0,8"
                  ToolTip="Listen for supported phrases while the tray runs. Prefer push-to-talk in VR."/>
        <CheckBox x:Name="PushToTalkBox" Content="Push-to-talk only (recommended)" Margin="0,0,0,8"
                  ToolTip="Only listen while the push-to-talk shortcut is held. Stops game audio from triggering commands."/>
        <CheckBox x:Name="AudioConfirmBox" Content="Spoken confirmation when a command is recognized" Margin="0,0,0,12"
                  ToolTip="Speak a short confirmation when a phrase is recognized so you know it fired in VR."/>

        <TextBlock Text="Push-to-talk shortcut" Style="{StaticResource SettingLabelStyle}"/>
        <TextBlock x:Name="PushToTalkText" Margin="0,0,0,8" Foreground="{DynamicResource AppMutedBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <Button x:Name="RecordPttButton" Content="Record shortcut…" Style="{StaticResource GhostButtonStyle}" Click="RecordPtt_Click"
                  ToolTip="Capture a new global push-to-talk chord. Esc cancels."/>
          <Button Content="Reset to Ctrl+Shift+V" Style="{StaticResource GhostButtonStyle}" Click="ResetPtt_Click"
                  ToolTip="Restore the default push-to-talk shortcut (Ctrl+Shift+V)."/>
        </StackPanel>

        <TextBlock Text="Supported phrases" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,8"/>
        <ListView x:Name="PhrasesList"
                  MinHeight="240"
                  Style="{StaticResource ThemedListViewStyle}"
                  ToolTip="Built-in phrases and the tray actions they run (e.g. kill dash, start service).">
          <ListView.View>
            <GridView ColumnHeaderContainerStyle="{StaticResource ThemedGridViewColumnHeaderStyle}">
              <GridViewColumn Header="Say this" Width="280" DisplayMemberBinding="{Binding Phrase}"/>
              <GridViewColumn Header="Action" Width="320" DisplayMemberBinding="{Binding ActionLabel}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
