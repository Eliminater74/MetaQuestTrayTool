<Window x:Class="MetaQuestTrayTool.Views.LibraryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MetaQuestTrayTool.Views.Converters"
        Title="Steam &amp; Meta library"
        Height="620"
        Width="780"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <Window.Resources>
    <converters:PathToImageConverter x:Key="PathToImage"/>
  </Window.Resources>
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top"
               Text="Steam &amp; Meta library"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{DynamicResource AppAccentBrush}"/>
    <TextBlock DockPanel.Dock="Top"
               Margin="0,4,0,12"
               Foreground="{DynamicResource AppMutedBrush}"
               Text="Steam is first-class: Launch arms a personal profile and starts via steam://run. Or Add selected to only create/edit a profile."/>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox x:Name="SearchBox"
               Width="280"
               Padding="8,6"
               VerticalContentAlignment="Center"
               TextChanged="SearchBox_TextChanged"
               ToolTip="Filter the library list by game name."/>
      <ComboBox x:Name="FilterBox"
                Margin="8,0,0,0"
                Width="160"
                Padding="6"
                SelectionChanged="FilterBox_SelectionChanged"
                ToolTip="Show All, Steam only, or Meta / Oculus library games."/>
      <Button Content="Refresh"
              Margin="8,0,0,0"
              Style="{StaticResource GhostButtonStyle}"
              Click="Refresh_Click"
              ToolTip="Rescan installed Steam and Meta library folders."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Launch"
              Style="{StaticResource AccentButtonStyle}"
              Click="Launch_Click"
              ToolTip="Create/arm a personal profile if needed, enable auto-apply, and launch (Steam via steam://run)."/>
      <Button Content="Add selected"
              Style="{StaticResource GhostButtonStyle}"
              Click="Add_Click"
              ToolTip="Create a personal profile for the selected game and open the editor (does not launch)."/>
      <Button Content="Cancel"
              Style="{StaticResource GhostButtonStyle}"
              Click="Cancel_Click"
              ToolTip="Close without adding a profile."/>
    </StackPanel>

    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Foreground="{DynamicResource AppMutedBrush}"/>

    <Border Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8">
      <ListBox x:Name="GameList"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{DynamicResource AppTextBrush}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               MouseDoubleClick="GameList_MouseDoubleClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,5"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="88" Height="42" CornerRadius="6" ClipToBounds="True"
                      Background="{DynamicResource AppFieldBrush}" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock Text="{Binding PlatformGlyph}"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Foreground="{DynamicResource AppMutedBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                  <Image Source="{Binding Artwork, Converter={StaticResource PathToImage}}"
                         Stretch="UniformToFill"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Foreground="{DynamicResource AppMutedBrush}" FontSize="12" Margin="0,2,0,0">
                  <Run Text="{Binding PlatformLabel, Mode=OneWay}"/>
                  <Run Text=" · "/>
                  <Run Text="{Binding ProcessName, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
