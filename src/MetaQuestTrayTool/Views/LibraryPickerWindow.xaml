<Window x:Class="MetaQuestTrayTool.Views.LibraryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add from library"
        Height="560"
        Width="720"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top"
               Text="Steam &amp; Meta library"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{StaticResource AppAccentBrush}"/>
    <TextBlock DockPanel.Dock="Top"
               Margin="0,4,0,12"
               Foreground="{StaticResource AppMutedBrush}"
               Text="Pick an installed game to create a personal profile. Process name is filled automatically when possible."/>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox x:Name="SearchBox"
               Width="280"
               Padding="8,6"
               VerticalContentAlignment="Center"
               TextChanged="SearchBox_TextChanged"/>
      <ComboBox x:Name="FilterBox"
                Margin="8,0,0,0"
                Width="160"
                Padding="6"
                SelectionChanged="FilterBox_SelectionChanged"/>
      <Button Content="Refresh"
              Margin="8,0,0,0"
              Style="{StaticResource GhostButtonStyle}"
              Click="Refresh_Click"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Add selected"
              Style="{StaticResource AccentButtonStyle}"
              Click="Add_Click"/>
      <Button Content="Cancel"
              Style="{StaticResource GhostButtonStyle}"
              Click="Cancel_Click"/>
    </StackPanel>

    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Foreground="{StaticResource AppMutedBrush}"/>

    <Border Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8">
      <ListBox x:Name="GameList"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{StaticResource AppTextBrush}"
               MouseDoubleClick="GameList_MouseDoubleClick"/>
    </Border>
  </DockPanel>
</Window>
