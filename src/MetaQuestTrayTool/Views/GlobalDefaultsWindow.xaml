<Window x:Class="MetaQuestTrayTool.Views.GlobalDefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global defaults"
        Height="360"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
      <Button Content="Apply now" Style="{StaticResource GhostButtonStyle}" Click="Apply_Click"/>
      <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Global defaults"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource AppAccentBrush}"/>
      <TextBlock Margin="0,6,0,16"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource AppMutedBrush}"
                 Text="These settings apply to every app that does not have a personal profile. Personal profiles override them while that process is running."/>

      <TextBlock Text="Super Sampling" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="SuperSamplingBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="ASW mode" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="AswBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="FOV multiplier (1.00 = unchanged)" Foreground="{StaticResource AppMutedBrush}"/>
      <TextBox x:Name="FovBox" Margin="0,4,0,0" Padding="8,6"/>
    </StackPanel>
  </DockPanel>
</Window>
