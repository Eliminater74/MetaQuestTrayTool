<Window x:Class="MetaQuestTrayTool.Views.GlobalDefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global defaults"
        Width="480"
        SizeToContent="Height"
        MinHeight="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,24,0,0">
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
      <Button Content="Apply now" Style="{StaticResource GhostButtonStyle}" Click="Apply_Click"/>
      <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Global defaults"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AppAccentBrush}"/>
      <TextBlock Margin="0,8,0,20"
                 TextWrapping="Wrap"
                 LineHeight="20"
                 Foreground="{DynamicResource AppMutedBrush}"
                 Text="These settings apply to every app that does not have a personal profile. Personal profiles override them while that process is running."/>

      <TextBlock Text="Super Sampling" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <ComboBox x:Name="SuperSamplingBox" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

      <TextBlock Text="ASW mode" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <ComboBox x:Name="AswBox" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

      <TextBlock Text="FOV multiplier" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,6"/>
      <TextBox x:Name="FovBox" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
      <TextBlock Text="1.00 leaves FOV unchanged. Typical range is 0.50 – 1.50."
                 Foreground="{DynamicResource AppMutedBrush}"
                 FontSize="12"
                 Margin="0,0,0,8"/>
    </StackPanel>
  </DockPanel>
</Window>
