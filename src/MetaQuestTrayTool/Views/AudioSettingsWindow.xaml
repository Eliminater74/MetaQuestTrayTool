<Window x:Class="MetaQuestTrayTool.Views.AudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Switching"
        Height="520"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
      <Button Content="Switch to VR now" Style="{StaticResource GhostButtonStyle}" Click="SwitchVr_Click"/>
      <Button Content="Restore fallback" Style="{StaticResource GhostButtonStyle}" Click="Restore_Click"/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Audio Switching"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource AppAccentBrush}"/>
      <TextBlock Margin="0,6,0,16"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource AppMutedBrush}"
                 Text="When auto-switch is on, VR devices are applied while OVRService is running and fallback devices are restored when it stops."/>

      <CheckBox x:Name="AutoSwitchBox"
                Margin="0,0,0,8"
                Foreground="{StaticResource AppTextBrush}"
                Content="Auto-switch with Oculus service"/>

      <CheckBox x:Name="CommunicationsBox"
                Margin="0,0,0,12"
                Foreground="{StaticResource AppTextBrush}"
                Content="Also set Communications role"/>

      <TextBlock Text="VR playback device" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="VrPlaybackBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="VR recording device" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="VrRecordingBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="Fallback playback device" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="FallbackPlaybackBox" Margin="0,4,0,12" Padding="6"/>

      <TextBlock Text="Fallback recording device" Foreground="{StaticResource AppMutedBrush}"/>
      <ComboBox x:Name="FallbackRecordingBox" Margin="0,4,0,8" Padding="6"/>

      <Button Content="Use current defaults as fallback"
              HorizontalAlignment="Left"
              Style="{StaticResource GhostButtonStyle}"
              Click="CaptureFallback_Click"/>
    </StackPanel>
  </DockPanel>
</Window>
