<Window x:Class="MetaQuestTrayTool.Views.AudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Switching"
        Height="640"
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"
              ToolTip="Save audio switching preferences without changing devices yet."/>
      <Button Content="Switch to VR now" Style="{StaticResource GhostButtonStyle}" Click="SwitchVr_Click"
              ToolTip="Set Windows default playback/recording to the selected VR devices immediately."/>
      <Button Content="Restore fallback" Style="{StaticResource GhostButtonStyle}" Click="Restore_Click"
              ToolTip="Restore the fallback (desktop) playback and recording devices now."/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"
              ToolTip="Close without saving unsaved edits."/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Audio Switching"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"/>
        <TextBlock x:Name="StatusText"
                   Margin="0,6,0,16"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"/>

        <CheckBox x:Name="AutoSwitchBox"
                  Margin="0,0,0,8"
                  Foreground="{DynamicResource AppTextBrush}"
                  Content="Auto-switch when Link is active / inactive"
                  ToolTip="Automatically switch to VR devices when Link connects and restore fallback when Link drops."/>

        <TextBlock Text="Detect Link using" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="TriggerBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="How to detect an active Link session for audio switching (Meta Link, Steam Link, VD, etc.)."/>

        <CheckBox x:Name="CaptureEachSessionBox"
                  Margin="0,0,0,8"
                  Foreground="{DynamicResource AppTextBrush}"
                  Content="Capture current desktop devices as fallback each time Link connects"
                  ToolTip="Before switching to VR, remember the current desktop devices as fallback for that session."/>

        <CheckBox x:Name="CommunicationsBox"
                  Margin="0,0,0,12"
                  Foreground="{DynamicResource AppTextBrush}"
                  Content="Also restore / set Communications role"
                  ToolTip="Also set the Windows Communications default (Discord, Teams, etc.), not only Multimedia."/>

        <TextBlock Text="VR playback (while Link active)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="VrPlaybackBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Default playback device while Link is active (usually the headset)."/>

        <TextBlock Text="VR recording (while Link active)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="VrRecordingBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Default recording device while Link is active (headset mic or preferred mic)."/>

        <TextBlock Text="Fallback playback (when Link inactive)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="FallbackPlaybackBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Desktop speakers/headphones restored when Link is inactive."/>

        <TextBlock Text="Fallback recording (when Link inactive)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="FallbackRecordingBox" Margin="0,4,0,8" Padding="6"
                  ToolTip="Desktop microphone restored when Link is inactive."/>

        <Button Content="Use current defaults as fallback"
                HorizontalAlignment="Left"
                Style="{StaticResource GhostButtonStyle}"
                Click="CaptureFallback_Click"
                ToolTip="Copy the current Windows default playback/recording devices into the fallback fields."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
