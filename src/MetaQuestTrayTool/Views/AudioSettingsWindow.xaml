<Window x:Class="MetaQuestTrayTool.Views.AudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Switching"
        Height="780"
        Width="600"
        MinHeight="520"
        MinWidth="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Switch to VR now" Style="{StaticResource AccentButtonStyle}" Click="SwitchVr_Click"
              ToolTip="Set Windows default playback/recording to the selected VR devices immediately."/>
      <Button Content="Restore fallback" Style="{StaticResource GhostButtonStyle}" Click="Restore_Click"
              ToolTip="Restore the fallback (desktop) playback and recording devices now."/>
      <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"
              ToolTip="Close (changes already saved as you edit)."/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Audio Switching"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentBrush}"/>
        <TextBlock x:Name="StatusText"
                   Margin="0,6,0,16"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMutedBrush}"/>

        <CheckBox x:Name="AutoSwitchBox"
                  Margin="0,0,0,8"
                  Foreground="{DynamicResource AppTextBrush}"
                  Content="Auto-switch on PCVR start / restore on PCVR end"
                  ToolTip="Leaves your boot/desktop audio alone. When a PCVR session starts, switch to VR devices; when it ends, restore fallback. Does not change devices just because the tray app starts."/>

        <TextBlock Text="Detect PCVR using" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="TriggerBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="How to detect an active PCVR session for audio switching (Meta Link, SteamVR, VD, etc.)."/>

        <CheckBox x:Name="CaptureEachSessionBox"
                  Margin="0,0,0,8"
                  Foreground="{DynamicResource AppTextBrush}"
                  Content="Capture current desktop devices as fallback each time PCVR starts"
                  ToolTip="Before switching to VR, remember the current desktop devices as fallback for that session."/>

        <CheckBox x:Name="CommunicationsBox"
                  Margin="0,0,0,12"
                  Foreground="{DynamicResource AppTextBrush}"
                  Content="Also restore / set Communications role"
                  ToolTip="Also set the Windows Communications default (Discord, Teams, etc.), not only Multimedia."/>

        <TextBlock Text="VR playback (while PCVR active)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="VrPlaybackBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Default playback device while PCVR is active (usually the headset)."/>

        <TextBlock Text="VR recording (while PCVR active)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="VrRecordingBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Default recording device while PCVR is active (headset mic or preferred mic)."/>

        <TextBlock Text="Fallback playback (desktop / when PCVR ends)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="FallbackPlaybackBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Desktop speakers/headphones restored when PCVR ends. Your boot defaults should match this."/>

        <TextBlock Text="Fallback recording (desktop / when PCVR ends)" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="FallbackRecordingBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Desktop microphone restored when PCVR ends."/>

        <TextBlock Text="Communications (Discord / Teams)" Margin="0,4,0,6"
                   FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"
                   Text="Optional. Leave on “(same as multimedia)” to reuse the VR/fallback devices above for the Windows Communications role."/>

        <TextBlock Text="VR communications playback" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="VrCommPlaybackBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Communications playback while Link is active. Empty = use VR multimedia playback."/>

        <TextBlock Text="VR communications recording" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="VrCommRecordingBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Communications recording (mic) while Link is active. Empty = use VR multimedia recording."/>

        <TextBlock Text="Fallback communications playback" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="FallbackCommPlaybackBox" Margin="0,4,0,12" Padding="6"
                  ToolTip="Communications playback when Link is inactive. Empty = use fallback multimedia playback."/>

        <TextBlock Text="Fallback communications recording" Foreground="{DynamicResource AppMutedBrush}"/>
        <ComboBox x:Name="FallbackCommRecordingBox" Margin="0,4,0,8" Padding="6"
                  ToolTip="Communications mic when Link is inactive. Empty = use fallback multimedia recording."/>

        <Button Content="Use current defaults as fallback"
                HorizontalAlignment="Left"
                Style="{StaticResource GhostButtonStyle}"
                Click="CaptureFallback_Click"
                ToolTip="Copy the current Windows default playback/recording devices into the fallback fields (including communications)."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
